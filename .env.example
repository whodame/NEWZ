# Токен Telegram-бота от @BotFather
TG_TOKEN=1234567890:AAH_your_telegram_bot_token_here

# ID вашего личного чата или канала (узнать можно у @userinfobot)
CHAT_ID=123456789

# API-ключ Google Gemini (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Модель Gemini (по умолчанию быстрая и экономичная gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Порт веб-сервера для Health Check Koyeb (по умолчанию 8000)
PORT=8000

# Интервал опроса RSS-лент в минутах (по умолчанию 15)
POLL_INTERVAL_MINUTES=15

# Интервал постепенной ИИ-сводки в часах ("потихоньку через ИИ", 0 — оставить только воскресный дайджест)
GRADUAL_DIGEST_HOURS=6

# Необязательно: внешняя PostgreSQL БД (например, бесплатный Neon.tech или Supabase),
# чтобы динамически добавленные через Telegram источники сохранялись при перезапуске контейнера Koyeb.
# Если оставить пустым, используется локальный файл SQLite (news.db).
DATABASE_URL=
